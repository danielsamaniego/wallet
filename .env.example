# Database
# Local dev (Docker Postgres):
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet?schema=public
# Production via Prisma Accelerate (HTTP transport, no TCP exhaustion under
# Vercel cold starts). Get the URL from console.prisma.io after enabling
# Accelerate. Format: prisma://accelerate.prisma-data.net/?api_key=...
# DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=__API_KEY__
#
# DIRECT_URL is the direct Postgres connection. Used by `prisma migrate`
# (Accelerate doesn't apply DDL) and falls back to DATABASE_URL when unset.
# In production, set this to the Supabase direct host (db.<ref>.supabase.co).
# DIRECT_URL=postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres

# Server
HTTP_PORT=3000
LOG_LEVEL=info

# Cron (auto-injected by Vercel in prod)
# CRON_SECRET=

# Wallet lock — per-wallet serialization (requires Redis)
# Set to true + provide REDIS_URL to enable. docker-compose.dev.yml
# enables it automatically against the bundled Redis container.
WALLET_LOCK_ENABLED=false
# REDIS_URL=redis://localhost:6379
# Managed Redis (Upstash, etc.): rediss://default:<TOKEN>@<host>:<port>

# Transport for the Redis client.
#   tcp  — ioredis persistent connection. ~1-5ms/op. Default. Use locally
#          or on long-lived processes.
#   rest — @upstash/redis over HTTPS. ~10-30ms/op. Stateless per-request;
#          ideal for serverless (Vercel, Lambda) where cold bursts would
#          otherwise exhaust Upstash's per-DB connection quota (EMAXCONN).
#          Parses host+token out of REDIS_URL.
# WALLET_LOCK_TRANSPORT=tcp

# Lock tuning (leave commented to use defaults)
# WALLET_LOCK_TTL_MS=10000
# WALLET_LOCK_WAIT_MS=5000
# WALLET_LOCK_RETRY_MS=50

# QStash — async movement processing
# Local dev (bundled in docker-compose.dev.yml as `qstash` service):
#   docker compose -f docker-compose.dev.yml up qstash
# The token and signing keys below are the well-known public dev values
# from upstash.com/docs/qstash/howto/local-development — DO NOT use in prod.
QSTASH_URL=http://localhost:8080
QSTASH_TOKEN=eyJVc2VySUQiOiJkZWZhdWx0VXNlciIsIlBhc3N3b3JkIjoiZGVmYXVsdFBhc3N3b3JkIn0=
QSTASH_CURRENT_SIGNING_KEY=sig_7kYjw48mhY7kAjqNGcy6cr29RJ6r
QSTASH_NEXT_SIGNING_KEY=sig_5ZB6DVzB1wjE8S6rZ7eenA8Pdnhs

# Wallet movement queue
WALLET_QSTASH_QUEUE_NAME=wallet-movements
# Local QStash dev server caps parallelism at 10. Production can go higher
# (recommended: 15, tunable based on Supabase compute tier).
WALLET_QUEUE_PARALLELISM=10
# URL QStash will POST to for each queued movement. From inside compose
# network use http://app:3000/...; from the host or in prod, the public URL.
WALLET_INTERNAL_WORKER_URL=http://localhost:3000/internal/worker/process-movement
# Max ms the HTTP handler waits for the worker's Redis-published result
# before returning 202 Accepted instead of 200 OK.
WALLET_HANDLER_WAIT_MS=1500
# Master switch for the async path. When false, handlers run the use case
# inline (legacy behavior). Used during the staged rollout.
WALLET_ASYNC_PROCESSING_ENABLED=false
